# Copy this file to the repository-root .env, then keep it readable only by the service account.
# /config remains closed until both access secrets below are set.

# CONFIG_PASSWORD_HASH=$argon2id$...
# CONFIG_SESSION_SECRET=...

# The external browser origin accepted in configuration request Origin headers.
PUBLIC_ORIGIN=https://apasz.com

# HTTPS-only cookies are the default. Use false only with an HTTP loopback origin.
# CONFIG_COOKIE_SECURE=true

# Optional SMTP notifications. Leave EMAIL_NOTIFICATION_EVENTS unset to disable email.
# Supported events: startup, configuration_saved
# EMAIL_NOTIFICATION_EVENTS=startup,configuration_saved
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURITY=starttls
# EMAIL_SMTP_USERNAME=...
# EMAIL_SMTP_PASSWORD=...
# EMAIL_FROM=hub@example.com
# EMAIL_TO=owner@example.com,backup@example.com
# Run `uv run apasz-hub-email-test` after configuring SMTP.

# Optional runtime overrides.
# PORT=2036
# HOST=127.0.0.1
# LINK_CARDS_PATH=*/apasz-hub/link_cards.json
# THEME_COLORS_PATH=*/apasz-hub/theme_colors.json
# OPEN_GRAPH_PATH=*/apasz-hub/open_graph.json
