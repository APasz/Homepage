# Copy this file to .env, then keep .env readable only by the service account.
# /config remains closed until both access secrets below are set.

# CONFIG_PASSWORD_HASH=$argon2id$...
# CONFIG_SESSION_SECRET=...

# The external browser origin permitted to submit configuration changes.
PUBLIC_ORIGIN=https://apasz.com

# HTTPS-only cookies are the default. Use false only with an HTTP loopback origin.
# CONFIG_COOKIE_SECURE=true

# Optional runtime overrides.
# PORT=5001
# HOST=127.0.0.1
# LINK_CARDS_PATH=*/apasz-hub/link_cards.json
# THEME_COLORS_PATH=*/apasz-hub/theme_colors.json
