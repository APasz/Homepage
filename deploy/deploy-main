#!/usr/bin/env bash
set -euo pipefail

umask 0027

readonly application_directory='/opt/apasz-hub'
readonly deployment_lock_file="$application_directory/.git/deploy.lock"
readonly branch_name='main'
readonly deploy_user='apasz-deploy'
readonly health_endpoint='http://127.0.0.1:1996/healthz'
readonly health_attempts=15
readonly health_retry_delay_seconds=1
readonly service_name='apasz-hub.service'
readonly uv_executable='/usr/local/bin/uv'
readonly uv_python_install_directory='/opt/uv/python'

commit_sha="${1:-}"
if [[ ! "$commit_sha" =~ ^[0-9a-f]{40}$ ]]; then
    echo 'A 40-character lowercase commit SHA is required.' >&2
    exit 64
fi

fetch_origin_commit_sha() {
    if ! git -C "$application_directory" fetch --no-tags origin \
        "+refs/heads/$branch_name:refs/remotes/origin/$branch_name"; then
        return 1
    fi
    git -C "$application_directory" rev-parse --verify \
        "refs/remotes/origin/$branch_name^{commit}"
}

wait_for_healthy_application() {
    local attempt

    for ((attempt = 1; attempt <= health_attempts; attempt += 1)); do
        if curl --noproxy '*' --fail --silent --show-error --max-time 3 \
            "$health_endpoint" >/dev/null; then
            return 0
        fi
        sleep "$health_retry_delay_seconds"
    done
    return 1
}

sync_dependencies() {
    env \
        HOME="/home/$deploy_user" \
        UV_PYTHON_INSTALL_DIR="$uv_python_install_directory" \
        "$uv_executable" sync --locked --no-dev --project "$application_directory"
}

restart_application() {
    sudo -n /usr/bin/systemctl restart "$service_name"
}

restore_previous_commit() {
    local previous_commit_sha="$1"

    echo "Restoring $previous_commit_sha." >&2
    if ! git -C "$application_directory" checkout --detach --force --quiet \
        "$previous_commit_sha"; then
        return 1
    fi
    if ! sync_dependencies; then
        return 1
    fi
    if ! restart_application; then
        return 1
    fi
    wait_for_healthy_application
}

rollback_and_exit() {
    local exit_status="$1"
    local previous_commit_sha="$2"
    local failure_message="$3"

    if restore_previous_commit "$previous_commit_sha"; then
        echo "$failure_message; rollback restored $previous_commit_sha." >&2
        exit "$exit_status"
    fi
    echo "$failure_message; rollback failed." >&2
    exit 1
}

if [[ ! -d "$application_directory/.git" ]]; then
    echo "Expected a Git checkout at $application_directory." >&2
    exit 1
fi
if [[ ! -x "$uv_executable" ]]; then
    echo "Expected uv at $uv_executable." >&2
    exit 1
fi
if ! checkout_status="$(
    git -C "$application_directory" status --porcelain --untracked-files=all
)"; then
    echo "Unable to inspect the checkout at $application_directory." >&2
    exit 1
fi
if [[ -n "$checkout_status" ]]; then
    echo "Refusing to deploy a dirty checkout at $application_directory." >&2
    exit 1
fi

exec 9>"$deployment_lock_file"
if ! flock --nonblock 9; then
    echo 'Another APasz Hub deployment is already running.' >&2
    exit 75
fi

if ! origin_commit_sha="$(fetch_origin_commit_sha)"; then
    echo "Unable to fetch origin/$branch_name." >&2
    exit 1
fi
if [[ "$commit_sha" != "$origin_commit_sha" ]]; then
    echo "Skipping stale deployment for $commit_sha; origin/$branch_name is now $origin_commit_sha."
    exit 0
fi

if ! previous_commit_sha="$(
    git -C "$application_directory" rev-parse --verify "HEAD^{commit}"
)"; then
    echo "Unable to resolve the current deployed commit." >&2
    exit 1
fi
if [[ "$previous_commit_sha" == "$commit_sha" ]]; then
    # A matching checkout does not prove an interrupted prior run restarted it.
    if ! sync_dependencies; then
        echo "Unable to synchronize dependencies for $commit_sha." >&2
        exit 1
    fi
    if ! restart_application; then
        echo "Unable to restart APasz Hub for $commit_sha." >&2
        exit 1
    fi
    if ! wait_for_healthy_application; then
        echo "APasz Hub did not pass its health check for $commit_sha." >&2
        exit 1
    fi
    echo "APasz Hub is serving $commit_sha."
    exit 0
fi

if ! git -C "$application_directory" checkout --detach --force --quiet \
    "$commit_sha"; then
    rollback_and_exit 1 "$previous_commit_sha" \
        "Unable to check out $commit_sha"
fi
if ! sync_dependencies; then
    rollback_and_exit 1 "$previous_commit_sha" \
        "Unable to synchronize dependencies for $commit_sha"
fi

if ! origin_commit_sha="$(fetch_origin_commit_sha)"; then
    rollback_and_exit 1 "$previous_commit_sha" \
        "Unable to verify origin/$branch_name after synchronizing dependencies for $commit_sha"
fi
if [[ "$commit_sha" != "$origin_commit_sha" ]]; then
    rollback_and_exit 0 "$previous_commit_sha" \
        "Not activating stale deployment $commit_sha; origin/$branch_name is now $origin_commit_sha"
fi

if ! restart_application; then
    rollback_and_exit 1 "$previous_commit_sha" \
        "Unable to restart APasz Hub for $commit_sha"
fi
if ! wait_for_healthy_application; then
    rollback_and_exit 1 "$previous_commit_sha" \
        "APasz Hub did not pass its health check for $commit_sha"
fi
echo "APasz Hub is serving $commit_sha."
